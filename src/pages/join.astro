---
import BaseLayout from "../layouts/BaseLayout.astro";

// Edit recruitment details here.
const email = "liujinghui@westlake.edu.cn";

// Official Westlake graduate admissions page.
const admissionsUrl = "https://en.westlake.edu.cn/admissions/graduate/";

// PhD program through which students can currently join the lab.
const program = "Quantitative Biology and Complex Systems";
const programNote =
  "This is currently the program through which I admit PhD students. If your background is elsewhere — physics, engineering, biology, chemistry, applied mathematics — please still get in touch. Co-affiliation with other programs is being arranged, and I am happy to advise on the best route in.";

// TODO: verify these dates against the official admissions page each cycle.
const phdRounds = [
  { label: "Next round", detail: "application materials due by 25 December 2026" },
  { label: "Following round", detail: "application materials due by 31 March 2027" },
];

const positions = [
  {
    id: "phd",
    title: "PhD students",
    intro:
      "We are recruiting PhD students to start in 2027. Westlake admits PhD students in several rounds each year, and all applications go through the university's official admissions process.",
    points: [
      "We welcome students from physics, engineering, biology, chemistry and applied mathematics. Your background matters less than the questions you want to answer.",
      "Experimentalists, theorists, and people who want to do both are all welcome.",
      "We are happy to talk before you apply. Email us (see below) as well as submitting your application.",
    ],
  },
  {
    id: "postdocs",
    title: "Postdoctoral researchers",
    intro:
      "We are looking for a postdoc to join at the start, and the first project is the instrument.",
    paragraphs: [
      "The lab runs on an all-optical platform: patterned optical stimulation of ion channels, voltage imaging, and long time-lapse of regenerating tissue, with microfluidics for controlled ionic and osmotic environments. Someone has to design and build it, and that person will shape what the lab is able to ask for years afterwards.",
      "This is a good position if you want to build. You would co-design the rig rather than inherit it, lead the methods work that comes out of it, and move into your own biological project as the platform comes online. It is not a good position if you want to be taking data in your first month.",
      "Relevant backgrounds include optical design and microscope assembly, all-optical electrophysiology, voltage imaging, optogenetics, light-sheet or other custom imaging systems, microfluidics, instrument control (Micro-Manager, Python), and quantitative image analysis. You will not have all of these, and we do not expect it.",
      "We will support applications for independent fellowships, and we are happy to talk long before you are ready to apply.",
    ],
  },
  {
    id: "technician",
    title: "Lab technician",
    intro:
      "We are looking for a lab technician to keep the lab running: zebrafish husbandry and lines, molecular biology, sample preparation, ordering and maintenance, and the daily operation of the imaging setups.",
    paragraphs: [
      "In a new lab this is a central role rather than a supporting one — the person who makes experiments possible sets the pace for everything else. We are looking for someone who wants to own it properly, and the position is intended to be long-term.",
    ],
  },
  {
    id: "assistants",
    title: "Research assistants",
    intro:
      "We are looking for research assistants to work on projects of their own within the lab's questions: running experiments, analysing data, and contributing to papers.",
    paragraphs: [
      "This suits someone between a master's and a PhD who wants a year or two of real research before committing to one, or someone with a quantitative background who wants to learn to work with living systems. You would be supervised directly, present your own work, and leave with something to show for it. Several of our first projects have pieces that can belong to one person.",
    ],
  },
  {
    id: "visiting",
    title: "Visiting students",
    intro:
      "Opportunities for visiting undergraduate and master's students may become available from 2027. If you are curious about the lab's questions and want to spend a few months on one, get in touch.",
  },
];
---

<BaseLayout title="Join Us">
  <main class="page-container">
    <header class="join-intro">
      <p class="page-eyebrow">Liu Lab · Join Us</p>
      <h1 class="page-title">Join the lab</h1>
      <p class="page-description">
        The Liu Lab opens at the Center for Interdisciplinary Studies, Westlake
        University, in September 2027. Founding members will help shape the
        lab's first projects, tools and culture. If you are curious about how
        living matter regenerates, we would love to hear from you.
      </p>
      <p class="join-research-link">
        <a href="/research">Read about our research themes <span aria-hidden="true">↗</span></a>
      </p>
    </header>

    <section class="looking-for" aria-labelledby="looking-for-title">
      <h2 id="looking-for-title">Who we are looking for</h2>
      <p>
        Students and postdocs from physics, biology, engineering or computation.
        You do not need a background in bioelectricity. If you are drawn to how
        organs rebuild themselves, to nonequilibrium and complex systems, to
        quantitative imaging, or to building the instrument that makes a
        measurement possible, there is a project here for you.
      </p>
    </section>

    <div class="positions">
      {positions.map(({ id, title, intro, paragraphs, points }) => (
        <section class="position" id={id} aria-labelledby={`${id}-title`}>
          <h2 id={`${id}-title`}>{title}</h2>
          <div class="position-copy">
            <p class="position-intro">{intro}</p>
            {paragraphs && paragraphs.map((text) => <p class="position-paragraph">{text}</p>)}
            {points && (
              <ul>
                {points.map((point) => <li>{point}</li>)}
              </ul>
            )}

            {id === "phd" && (
              <div class="rounds">
                <p class="rounds-title">Upcoming admission rounds</p>
                <ul>
                  {phdRounds.map(({ label, detail }) => (
                    <li><strong>{label}:</strong> {detail}</li>
                  ))}
                </ul>
                <p class="rounds-title">You can join the lab through this PhD program</p>
                <p class="program-name">{program}</p>
                <p class="program-note">{programNote}</p>
                {admissionsUrl && (
                  <a href={admissionsUrl} target="_blank" rel="noopener noreferrer">
                    Apply through Westlake graduate admissions <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <section class="contact-callout" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">How to get in touch</h2>
        <p>
          Email <a href={`mailto:${email}`}>{email}</a> with the subject line{" "}
          <strong>"[Prospective PhD / Postdoc / Technician / RA] Your Name"</strong> and include:
        </p>
        <ol>
          <li>your CV;</li>
          <li>a short note (up to one page) on what draws you to the lab, and a question you would like to explore;</li>
          <li>for postdocs, two reference letters.</li>
        </ol>
        <p class="contact-note">
          We read every message. Please allow some time for a reply while the lab is being set up.
        </p>
      </div>
      <a class="contact-button" href={`mailto:${email}?subject=[Prospective%20PhD%20/%20Postdoc%20/%20Technician%20/%20RA]%20`}>
        Email the lab <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .join-intro {
    margin-bottom: 64px;
  }

  .looking-for {
    margin-bottom: 64px;
    padding: clamp(24px, 4vw, 44px);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-light-background);
  }

  .looking-for h2 {
    margin: 0 0 12px;
    font-size: clamp(23px, 2.5vw, 30px);
    letter-spacing: -0.025em;
  }

  .looking-for p {
    max-width: 900px;
    margin: 0;
    color: var(--color-secondary);
    font-size: var(--font-size-prose);
    line-height: 1.7;
  }

  .rounds .program-name {
    margin: 0 0 8px;
    color: var(--color-text);
    font-size: var(--font-size-prose);
    font-weight: 700;
  }

  .rounds .program-note {
    margin: 0 0 16px;
  }

  .join-research-link a,
  .rounds a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .join-research-link a:hover,
  .rounds a:hover {
    border-bottom-color: currentColor;
  }

  .position {
    display: grid;
    grid-template-columns: minmax(160px, 260px) minmax(0, 1fr);
    gap: 40px;
    padding-block: 44px;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 160px;
  }

  .position h2,
  .contact-callout h2 {
    margin: 0;
    font-size: clamp(23px, 2.5vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .position-copy p,
  .position-copy li {
    color: var(--color-secondary);
    font-size: var(--font-size-prose);
    line-height: 1.7;
  }

  .position-copy > .position-intro {
    margin: 0 0 12px;
    color: var(--color-text);
  }

  .position-copy > .position-paragraph {
    margin: 0 0 12px;
  }

  .position-copy > .position-paragraph:last-child {
    margin-bottom: 0;
  }

  .position-copy ul {
    margin: 0;
    padding-left: 1.2em;
  }

  .rounds {
    margin-top: 28px;
    padding: 20px 24px;
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-light-background);
  }

  .rounds .rounds-title {
    margin: 0 0 8px;
    color: var(--color-text);
    font-weight: 700;
  }

  .rounds ul {
    margin-bottom: 16px;
  }

  .contact-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-top: 44px;
    padding: clamp(24px, 4vw, 52px);
    border-radius: 12px;
    background: var(--color-button);
    color: white;
  }

  .contact-callout > div {
    max-width: 760px;
  }

  .contact-callout h2 {
    margin-bottom: 16px;
  }

  .contact-callout p,
  .contact-callout li {
    font-size: 18px;
    line-height: 1.6;
  }

  .contact-callout ol {
    padding-left: 1.2em;
  }

  .contact-callout .contact-note {
    margin-bottom: 0;
    opacity: 0.85;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid currentColor;
    border-radius: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  .contact-button:hover {
    background: white;
    color: var(--color-button);
    border-color: white;
  }

  @media (max-width: 800px) {
    .join-intro {
      margin-bottom: 40px;
    }

    .position {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
