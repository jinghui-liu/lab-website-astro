
---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
---

<BaseLayout title="Home">
  <main class="home-main">

    <!-- CINEMATIC OPENING -->
    <section class="video-hero">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source
          src="/videos/larvalfishfin-regeneration.mp4"
          type="video/mp4"
        />
      </video>

      <div class="hero-overlay">
        <h1>Living<br />Electrodynamics</h1>
        <p>
          DISCOVERING THE LATENT VARIABLES OF LIFE
        </p>
      </div>

      <a href="#mission" class="scroll-prompt">
        <span>Our Mission</span>
        <span class="arrow">↓</span>
      </a>
    </section>

    <!-- MISSION STATEMENT -->
    <section id="mission" class="mission-section">
      <div class="mission-content">
        <p class="eyebrow">
          DISCOVERING THE LATENT VARIABLES OF LIFE
        </p>

        <h2>Living Electrodynamics</h2>

        <p>
          We integrate interdisciplinary approaches to uncover how latent
          electrical states and fluctuations—from ionic currents to voltage gradients—
         shape living systems.
        </p>

        <p>
          Combining all-optical physiology, theoretical modeling
          and AI-driven tools, we seek to map the electrodynamical
          landscapes underlying complex morphogenetic processes like tissue regeneration.
        </p>

        <p>
          Building on these insights, we develop synthetic
          approaches to sense, guide and reprogram biological processes-- from decoding molecular dynamics through electrical fluctuations to controlling morphogenesis in on-chip systems.
        </p>

        <div class="mission-actions">
  <a class="mission-button research-button" href="/research">
    Explore Research
    <span aria-hidden="true">↗</span>
  </a>

  <a class="mission-button research-button" href="/publications">
    Check Publications
    <span aria-hidden="true">↗</span>
  </a>

  <a class="mission-button recruiting-button" href="/join">
    We Are Recruiting
    <span aria-hidden="true">↗</span>
  </a>
</div>

      </div>
      <a href="#lab-news" class="scroll-prompt mission-scroll-prompt">
        <span>Check News</span>
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    
<!-- RESEARCH THEMES + LAB NEWS -->
<section class="home-updates" id="lab-news">

  
<!-- LEFT: RESEARCH THEMES -->
<div class="research-column">
  <p class="section-eyebrow">WHAT WE EXPLORE</p>
  <h2>Research Themes</h2>

  <div class="research-list">

    <article class="research-item">
      <span class="item-number">01</span>
      <h3>Electrical Morphogenesis</h3>
      <p>
        How electrical signals shape biological form and regeneration.
      </p>
    </article>

    <article class="research-item">
      <span class="item-number">02</span>
      <h3>Latent Electrical Dynamics</h3>
      <p>
        Decoding the fluctuations and physical states underlying living systems.
      </p>
    </article>

    <article class="research-item">
      <span class="item-number">03</span>
      <h3>Sensing and Programming Life</h3>
      <p>
        Engineering electrical interfaces to read and control biological processes.
      </p>
    </article>

  </div>

  <a class="section-link" href="/research">
    Explore Our Research ↗
  </a>
</div>

  <!-- RIGHT: LAB NEWS -->
  <div class="news-column">
    <p class="section-eyebrow">LATEST UPDATES</p>
    <h2>Lab News</h2>

    <div class="news-list">
      <article class="news-item recruitment">
        <span class="news-date">RECRUITMENT</span>
        <h3>Join the Liu Lab</h3>
        <p>
          We welcome motivated researchers interested
          in the physics of living systems.
        </p>
        <a href="/join">
          How to Join ↗
        </a>
      </article>

      <article class="news-item">
        <span class="news-date">COMING SOON</span>
        <h3>Living Electrodynamics Lab @Westlake_CIS</h3>
        <p>
          In Sep 1 2027, we will launch at the Center for
          Interdisciplinary Studies!
          </p>

          <p>

          PhD students from all Schools are welcomed to get in touch.
        </p>
      </article>

    </div>
  </div>

</section>


  </main>
</BaseLayout>
