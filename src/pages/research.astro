---
import BaseLayout from "../layouts/BaseLayout.astro";

// Edit the introduction and research themes here.
const introduction =
  "How does a tissue know what to rebuild? An amputated fin grows back to the size it was, so the cells that remain must hold information about the missing structure, read it out, and act on it. Alongside morphogens and gene expression, cells carry a further layer of that information in their charge distributions and ionic currents. We ask where the information sits, how few variables carry it, and what happens when we change them: we perturb a tissue, read the state that follows, and commit to a prediction before it rebuilds.";

const openness =
  "These themes are starting points rather than boundaries. The questions under each one are examples of what we find exciting, and we expect new members to bring questions of their own.";

const themes = [
  {
    id: "electrical-states-tissue-function",
    title: "Electrical states and tissue function",
    question: "How few electrical and ionic variables are enough to predict how a tissue will regenerate?",
    description:
      "A tissue’s electrical state can be measured and manipulated. Whether it rebuilds, and to what size, is much harder to say: tissue behaviour is high-dimensional, and most of those dimensions turn out not to matter. We use channel mutants and ionic conditions as the axes, and test sufficiency by prediction.",
    examples: [
      "Is the information in the magnitude of a tissue’s electrical state, its spread across cells, or its pattern in space?",
      "How few variables are enough to predict the regeneration outcome before it happens?",
      "Where does the electrical state stop being enough, and molecular detail start to matter?",
    ],
  },
  {
    id: "kinetics-of-regeneration",
    title: "The kinetics of regeneration",
    question: "What sets the rate of regeneration, and the window in which it is still possible?",
    description:
      "Regeneration is a race: a tissue must rebuild before the window for rebuilding closes. Rates and windows differ between tissues, between mutants, and between animals — and that variation is a natural experiment, one that lets us ask what the constraint really is and why evolution settled where it did.",
    examples: [
      "Is a tissue that fails to regenerate one that cannot, or one that ran out of time?",
      "Does when a perturbation arrives matter as much as how large it is?",
      "Why do rates and windows differ between animals, and what constraint does that reveal?",
    ],
  },
  {
    id: "programmable-morphogenesis",
    title: "Programmable morphogenesis",
    question: "Can form be specified electrically?",
    description:
      "Tissues are usually steered by morphogens, by geometry, or by mechanics. We ask whether the same can be done electrically: whether setting channel activity, ionic conditions and applied fields in space and time is enough to specify what a tissue builds.",
    examples: [
      "Can a spatial pattern of channel activity specify form, the way a morphogen gradient does?",
      "What is the smallest input that reliably produces a given shape?",
      "Does a brief input leave a lasting change — can a tissue, an organ, or an organ on a chip be trained?",
    ],
  },
];
---

<BaseLayout title="Research">
  <main class="page-container research-page">
    <header class="research-intro">
      <p class="page-eyebrow">Liu Lab · Physics of Regenerative Soft Matter</p>
      <h1 class="page-title">Research</h1>
      <p class="page-description">{introduction}</p>
      <p class="openness-note">{openness}</p>
    </header>

    <nav class="theme-nav" aria-label="Research themes">
      <ul>
        {themes.map(({ id, title }) => (
          <li>
            <a href={`#${id}`}>{title}<span aria-hidden="true">↓</span></a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="themes">
      {themes.map(({ id, title, question, description, examples }) => (
        <section class="theme" id={id} aria-labelledby={`${id}-title`}>
          <h2 id={`${id}-title`}>{title}</h2>
          <div class="theme-copy">
            <p class="theme-question">{question}</p>
            <p>{description}</p>
            <div class="examples">
              <p class="examples-title">Some questions we are curious about</p>
              <ul>
                {examples.map((example) => <li>{example}</li>)}
              </ul>
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="own-question" aria-labelledby="own-question-title">
      <h2 id="own-question-title">Have a question that does not fit here?</h2>
      <p>
        Some of our best projects may not belong to any theme yet. If you are
        curious about how organs rebuild themselves, and what physics can say
        about it, we would love to hear your idea.
      </p>
      <a href="/join">Join us <span aria-hidden="true">↗</span></a>
    </section>

    <section class="publications-callout" aria-labelledby="publications-title">
      <h2 id="publications-title">Publications</h2>
      <a href="/publications">Browse publications <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  .research-intro {
    margin-bottom: 80px;
  }

  /* Wider page so the introduction reads in fewer lines */
  .research-page {
    padding-inline: 5%;
  }

  .research-intro .page-description,
  .openness-note {
    text-wrap: pretty;
  }

  .research-intro .page-description {
    max-width: none;
    font-size: clamp(20px, 1.22vw, 22px);
  }

  .theme-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0 0 28px;
  }

  .theme-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 15px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-button);
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .theme-nav a:hover {
    background: var(--color-light-background);
    border-color: var(--color-accent);
  }

  .openness-note {
    max-width: none;
    margin: 0;
    padding-left: 16px;
    border-left: 3px solid var(--color-accent);
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.6;
  }

  .examples {
    margin-top: 24px;
    padding: 18px 22px;
    border-radius: 8px;
    background: var(--color-light-background);
  }

  .examples-title {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .examples ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-secondary);
    font-size: 18px;
    line-height: 1.6;
  }

  .own-question {
    margin: 12px 0 44px;
    padding: clamp(24px, 4vw, 44px);
    border-top: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-light-background);
  }

  .own-question h2 {
    margin: 0 0 12px;
    font-size: clamp(23px, 2.5vw, 30px);
    letter-spacing: -0.025em;
  }

  .own-question p {
    max-width: 760px;
    margin: 0 0 16px;
    color: var(--color-secondary);
    font-size: 18px;
    line-height: 1.6;
  }

  .own-question a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .theme {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr);
    gap: 40px;
    padding-block: 44px;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 160px;
  }

  .theme h2,
  .publications-callout h2 {
    margin: 0;
    font-size: clamp(23px, 2.5vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .theme-copy > p {
    margin: 0;
    color: var(--color-secondary);
    font-size: var(--font-size-prose);
    line-height: 1.7;
  }

  .theme-copy > .theme-question {
    margin-bottom: 12px;
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.4;
  }


  .publications-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(24px, 4vw, 52px);
    border-radius: 12px;
    background: var(--color-button);
    color: white;
  }

  .publications-callout a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid currentColor;
    border-radius: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  .publications-callout a:hover {
    background: white;
    color: var(--color-button);
    border-color: white;
  }

  @media (max-width: 800px) {
    .research-intro {
      margin-bottom: 48px;
    }

    .theme {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
